.{
    .name = .zig_stack_adapter_examples,
    .version = "0.0.0",
    .fingerprint = 0x5886799e13e0341e,
    .minimum_zig_version = "0.16.0",

    .dependencies = .{
        // Single dependency: zGameLib, the framework over the two adapters.
        // Everything in this repo reaches the adapter libs (windowing/input +
        // the vulkan stack) THROUGH zGameLib — never directly. zGameLib owns
        // the adapter submodules + links their artifacts and re-exports them:
        //   - `zgame`           — the full framework (platform + vulkan + glue)
        //   - `zgame_platform`  — platform-only (links no vulkan; the gate path)
        // It's a local-path dep into the libs/zGameLib submodule (libs-first /
        // link-the-artifact — see libs/README.md).
        .zgame = .{ .path = "libs/zGameLib" },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "examples",
        "README.md",
        "LICENSE",
    },
}
