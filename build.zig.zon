.{
    .name = .zig_stack_adapter_examples,
    .version = "0.0.0",
    .fingerprint = 0x5886799e13e0341e,
    .minimum_zig_version = "0.16.0",

    .dependencies = .{
        // Local-path deps into libs/. Each lib builds from its local
        // checkout; build.zig links the lib's compiled static-library
        // artifact (libs-first / link-the-artifact — see libs/README.md).
        .platform = .{ .path = "libs/zig-cpp-platform-stack-adapter" },
        .vulkan_stack = .{ .path = "libs/zig-cpp-vulkan-stack-adapter" },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "shared",
        "examples",
        "tests",
        "README.md",
        "LICENSE",
    },
}
